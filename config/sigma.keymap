#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        M_P1: M_P1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N &kp I &kp S &kp E &kp N &kp O &kp M &kp O &kp N &kp O &kp AT &kp N &kp A &kp V &kp E &kp R &kp DOT &kp C &kp O &kp M>;
            label = "M_P1";
        };

        M_P2: M_P2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(R) &kp E &kp LS(G) &kp E &kp N &kp LS(B) &kp O &kp T &kp N0 &kp N3>;
            label = "M_P2";
        };

        CN_01: CN_01 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_3 &kp KP_NUMBER_9 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_01";
        };

        CN_02: CN_02 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_0 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_02";
        };

        CN_03: CN_03 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_03";
        };

        CN_04: CN_04 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_2 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_04";
        };

        CN_05: CN_05 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_05";
        };

        CN_06: CN_06 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_4 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_06";
        };

        CN_07: CN_07 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_07";
        };

        CN_08: CN_08 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_6 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_08";
        };

        CN_09: CN_09 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_7 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_09";
        };

        CN_10: CN_10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_8 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "CN_10";
        };

        M_BR: M_BR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "M_BR";
        };

        M_SQ: M_SQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "M_SQ";
        };

        M_HP: M_HP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp MINUS &kp SPACE>;
            label = "M_HP";
        };

        M_CL: M_CL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp COLON &kp SPACE>;
            label = "M_CL";
        };

        M_CP: M_CP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kt LC(C) &kp ESCAPE>;
            label = "M_CP";
        };

        M_PT: M_PT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F2 &kp LC(V) &kp ENTER>;
            label = "M_PT";
        };

        M_UB: M_UB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT &kp LS(MINUS)>;
            label = "M_UB";
        };

        M_SP: M_SP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp SPACE &kp SPACE &kp SPACE>;
            label = "M_SP";
        };

        SC_A: SC_A {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_9 &kp KP_NUMBER_7 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_A";
        };

        SC_S: SC_S {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_8 &kp KP_NUMBER_2 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_S";
        };

        SC_C: SC_C {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_6 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_C";
        };

        SC_V: SC_V {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_4 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_V";
        };

        SC_D: SC_D {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_6 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_D";
        };

        SC_R: SC_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_R";
        };

        SC_O: SC_O {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_2 &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_O";
        };

        SC_X: SC_X {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_3 &kp KP_NUMBER_2 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_X";
        };

        SC_PM: SC_PM {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_7 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_PM";
        };

        SC_DOT: SC_DOT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_8 &kp KP_NUMBER_3 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_DOT";
        };

        SC_DDOT: SC_DDOT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_3 &kp KP_NUMBER_3 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_DDOT";
        };

        SC_RR: SC_RR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_3 &kp KP_NUMBER_3 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_RR";
        };

        SC_LFT: SC_LFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_4 &kp KP_NUMBER_7 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_LFT";
        };

        SC_RGT: SC_RGT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_4 &kp KP_NUMBER_6 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_RGT";
        };

        SC_UP: SC_UP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_4 &kp KP_NUMBER_8 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_UP";
        };

        SC_DWN: SC_DWN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_4 &kp KP_NUMBER_9 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_DWN";
        };

        SC_LB: SC_LB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_0 &kp KP_NUMBER_2 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_LB";
        };

        SC_RB: SC_RB {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_4 &kp KP_NUMBER_0 &kp KP_NUMBER_3 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_RB";
        };

        SC_H: SC_H {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_NUMLOCK &kt LEFT_ALT &kp KP_NUMBER_4 &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_9 &kp KP_NUMBER_2 &kt LEFT_ALT &kp KP_NUMLOCK>;
            label = "SC_H";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QRT";
            bindings = <
&kp ESC    &kp N1    &kp N2  &kp N3  &kp N4     &kp N5          &kp N6           &kp N7     &kp N8  &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q     &kp W   &kp E   &kp R      &kp T           &kp Y            &kp U      &kp I   &kp O    &kp P     &kp DEL
&kp LSHFT  &kp A     &kp S   &kp D   &kp F      &kp G           &kp H            &kp J      &kp K   &kp L    &kp SEMI  &kp RET
&kp LCTRL  &kp LALT  &kp Z   &kp X   &kp C      &kp V           &kp B            &kp N      &kp M   &kp DOT  &kp FSLH  &kp RSHFT
                                     &kp SPACE  &lt 1 LEFT_GUI  &lt 2 RIGHT_ALT  &kp SPACE
            >;
        };

        raise_layer {
            display-name = "RSE";
            bindings = <
&kp LA(GRAVE)      &kp N7  &kp N8   &kp N9     &kp C_VOL_DN  &kp C_VOL_UP  &kp PAGE_DOWN  &kp PAGE_UP       &msc SCRL_LEFT     &msc SCRL_RIGHT  &trans           &trans
&kp KP_NLCK        &kp N4  &kp N5   &kp N6     &M_P1         &M_P2         &SC_DDOT       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE   &kp RIGHT_BRACE  &trans
&trans             &kp N1  &kp N2   &kp N3     &M_BR         &M_SQ         &M_HP          &kp MINUS         &kp PLUS           &kp EQUAL        &kp SQT          &trans
&kp RIGHT_CONTROL  &kp N0  &kp DOT  &kp ENTER  &M_CP         &M_PT         &M_CL          &kp LESS_THAN     &kp GREATER_THAN   &kp COMMA        &kp BSLH         &trans
                                               &kp F2        &trans        &kp C_MUTE     &kp LG(DOT)
            >;
        };

        lower_layer {
            display-name = "LWR";
            bindings = <
&kp F1    &kp F2  &kp F3  &kp F4  &kp F5         &kp F6           &kp F7         &kp F8         &kp F9         &kp F10            &kp F11    &kp F12
&kp CAPS  &trans  &trans  &trans  &trans         &trans           &kp LC(LA(G))  &kp LC(LA(S))  &kp LC(LS(I))  &kp LC(LS(C))      &kp LA(E)  &trans
&trans    &trans  &trans  &trans  &trans         &trans           &kp LS(F6)     &kp LS(F5)     &kp LC(M)      &kp LC(LA(LS(B)))  &trans     &kp LA(ENTER)
&trans    &trans  &trans  &trans  &trans         &trans           &kp LC(LS(S))  &M_UB          &kp LEFT       &kp DOWN           &kp UP     &kp RIGHT
                                  &kp LG(LS(S))  &kp PRINTSCREEN  &trans         &kp RIGHT_ALT
            >;
        };

        symbol_layer {
            display-name = "SBL";
            bindings = <
&kp LA(GRAVE)   &CN_01      &CN_02      &CN_03  &CN_04  &CN_05  &CN_06  &CN_07  &CN_08   &CN_09   &CN_10   &trans
&trans          &bt BT_PRV  &bt BT_NXT  &trans  &trans  &trans  &trans  &trans  &trans   &SC_O    &SC_PM   &trans
&bt BT_CLR      &SC_A       &SC_S       &SC_D   &trans  &trans  &SC_H   &trans  &trans   &trans   &SC_DOT  &SC_RR
&bt BT_CLR_ALL  &kp GRAVE   &trans      &SC_X   &SC_C   &SC_V   &SC_LB  &SC_RB  &SC_LFT  &SC_DWN  &SC_UP   &SC_RGT
                                                &M_SP   &trans  &trans  &M_SP
            >;
        };
    };
};
