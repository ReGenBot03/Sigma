#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    aliases {
        led-red = &led0;
        led-green = &led1;
        led-blue = &led2;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                            RC(4,4) RC(4,5)    RC(4,6) RC(4,7)
            >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Sigma Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys                     //  w   h    x    y  rot  rx  ry
            // Left Row 0
            = <&key_physical_attrs 100 100    0   75    0   0   0>
            , <&key_physical_attrs 100 100  100   50    0   0   0>
            , <&key_physical_attrs 100 100  200   25    0   0   0>
            , <&key_physical_attrs 100 100  300    0    0   0   0>
            , <&key_physical_attrs 100 100  400    0    0   0   0>
            , <&key_physical_attrs 100 100  500   25    0   0   0>
            // Right Row 0
            , <&key_physical_attrs 100 100  700   25    0   0   0>
            , <&key_physical_attrs 100 100  800    0    0   0   0>
            , <&key_physical_attrs 100 100  900    0    0   0   0>
            , <&key_physical_attrs 100 100 1000   25    0   0   0>
            , <&key_physical_attrs 100 100 1100   50    0   0   0>
            , <&key_physical_attrs 100 100 1200   75    0   0   0>

            // Left Row 1
            , <&key_physical_attrs 100 100    0  175    0   0   0>
            , <&key_physical_attrs 100 100  100  150    0   0   0>
            , <&key_physical_attrs 100 100  200  125    0   0   0>
            , <&key_physical_attrs 100 100  300  100    0   0   0>
            , <&key_physical_attrs 100 100  400  100    0   0   0>
            , <&key_physical_attrs 100 100  500  125    0   0   0>
            // Right Row 1
            , <&key_physical_attrs 100 100  700  125    0   0   0>
            , <&key_physical_attrs 100 100  800  100    0   0   0>
            , <&key_physical_attrs 100 100  900  100    0   0   0>
            , <&key_physical_attrs 100 100 1000  125    0   0   0>
            , <&key_physical_attrs 100 100 1100  150    0   0   0>
            , <&key_physical_attrs 100 100 1200  175    0   0   0>

            // Left Row 2
            , <&key_physical_attrs 100 100    0  275    0   0   0>
            , <&key_physical_attrs 100 100  100  250    0   0   0>
            , <&key_physical_attrs 100 100  200  225    0   0   0>
            , <&key_physical_attrs 100 100  300  200    0   0   0>
            , <&key_physical_attrs 100 100  400  200    0   0   0>
            , <&key_physical_attrs 100 100  500  225    0   0   0>
            // Right Row 2
            , <&key_physical_attrs 100 100  700  225    0   0   0>
            , <&key_physical_attrs 100 100  800  200    0   0   0>
            , <&key_physical_attrs 100 100  900  200    0   0   0>
            , <&key_physical_attrs 100 100 1000  225    0   0   0>
            , <&key_physical_attrs 100 100 1100  250    0   0   0>
            , <&key_physical_attrs 100 100 1200  275    0   0   0>

            // Left Row 3
            , <&key_physical_attrs 100 100    0  375    0   0   0>
            , <&key_physical_attrs 100 100  100  350    0   0   0>
            , <&key_physical_attrs 100 100  200  325    0   0   0>
            , <&key_physical_attrs 100 100  300  300    0   0   0>
            , <&key_physical_attrs 100 100  400  300    0   0   0>
            , <&key_physical_attrs 100 100  500  325    0   0   0>
            // Right Row 3
            , <&key_physical_attrs 100 100  700  325    0   0   0>
            , <&key_physical_attrs 100 100  800  300    0   0   0>
            , <&key_physical_attrs 100 100  900  300    0   0   0>
            , <&key_physical_attrs 100 100 1000  325    0   0   0>
            , <&key_physical_attrs 100 100 1100  350    0   0   0>
            , <&key_physical_attrs 100 100 1200  375    0   0   0>

            // Left Thumbs
            , <&key_physical_attrs 100 100  425  425    0   0   0>
            , <&key_physical_attrs 100 100  525  425    0   0   0>
            // Right Thumbs
            , <&key_physical_attrs 100 100  675  425    0   0   0>
            , <&key_physical_attrs 100 100  775  425    0   0   0>
            ;
    };
};

&xiao_spi { status = "disabled"; };
&xiao_i2c { status = "disabled"; };
&xiao_serial { status = "disabled"; };
